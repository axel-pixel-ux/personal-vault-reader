# ==============================================================================
# Configuration Personal Vault Reader (Folio) — Auto-hébergement VM Freebox
# ==============================================================================

# Base de données PostgreSQL locale (gérée par docker-compose)
POSTGRES_USER=vault
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=vault
DATABASE_URL="postgres://vault:change_me_strong_db_password@localhost:5432/vault"

# Secrets cryptographiques obligatoires en production :
# Générés automatiquement par ./deploy-freebox.sh (ou via `openssl rand -hex 32`)
JWT_SECRET=""
VAULT_KEK=""

# Répertoire de stockage des livres chiffrés (AES-256-GCM)
VAULT_STORAGE_DIR="./data/vault-files"

# URL publique / Tailscale de l'application (utile pour le callback OAuth Google Drive)
# Exemple Tailscale : https://folio.tail12345.ts.net
APP_URL=""
DOMAIN_NAME="localhost"

# Identifiants OAuth Google Drive optionnels (peuvent aussi être saisis directement dans l'interface)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Envoi d'e-mails pour "Mot de passe oublié" (ex: Gmail SMTP avec Mot de passe d'application Google)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="votre.email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Folio <votre.email@gmail.com>"

# Clé API Google Gemini (Free tier gratuit sur https://aistudio.google.com/app/apikey)
# Utilisée pour la classification automatique des thèmes en Grands Thèmes et Sous-thèmes
GEMINI_API_KEY=""

PORT=3001
